{
  // Sitio estático de Growpipe servido por Cloudflare Workers (solo assets, sin código propio).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growpipe-website",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],

  // Carpeta con los archivos del sitio.
  "assets": {
    "directory": "./public"
  },

  // Dominio personalizado: Cloudflare crea el registro DNS y el certificado.
  "routes": [
    { "pattern": "growpipe.co", "custom_domain": true }
  ],

  // Una sola URL pública: se apagan workers.dev y las URLs de vista previa.
  "workers_dev": false,
  "preview_urls": false,

  // Igual que la configuración actual en producción.
  "observability": {
    "enabled": true
  }
}
